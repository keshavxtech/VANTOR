NEXT_PUBLIC_SITE_URL=
# Supabase project settings (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Existing VANTOR AI secret (server-side only)
GEMINI_API_KEY=

# Optional provider keys. Leave blank to keep the provider disabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# GitHub App integration (server-only except the client ID)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_APP_SLUG=
# Optional; defaults to /api/github/callback on the current deployment URL.
GITHUB_CALLBACK_URL=
